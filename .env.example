# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Local LLM (Ollama) ────────────────────────────────────────────────────────
# URL of the Ollama server running the abliterated model
OLLAMA_BASE_URL=http://localhost:11434
# Model name loaded in Ollama, e.g. a NousResearch abliterated variant
OLLAMA_MODEL=llama3

# ── Knowledge Base ────────────────────────────────────────────────────────────
# Path to the SQLite database file (created automatically)
KB_DB_PATH=freegpt.db

# ── Plugins ───────────────────────────────────────────────────────────────────
# Comma-separated list of plugin module names to load at startup
# Supported: browse,mcp,code_editor
ENABLED_PLUGINS=browse,mcp

# ── MCP (Model Context Protocol) ─────────────────────────────────────────────
# Base URL of the MCP server (optional – only needed when mcp plugin is enabled)
MCP_SERVER_URL=http://localhost:3000

# ── Code-editor plugin (self-modification via Copilot / OpenAI-compat API) ───
# OpenAI-compatible API key (GitHub Copilot or OpenAI)
COPILOT_API_KEY=your_copilot_or_openai_key_here
# OpenAI-compatible endpoint (leave empty to use OpenAI default)
COPILOT_BASE_URL=https://api.openai.com/v1
# Model to use for code suggestions
COPILOT_MODEL=gpt-4o

# ── Allowed Telegram users ────────────────────────────────────────────────────
# Comma-separated Telegram user IDs allowed to interact with the bot.
# Leave empty to allow everyone.
ALLOWED_USER_IDS=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
